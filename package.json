{
  "name": "candidate-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Aptitude Assessment Platform - monorepo (server + web)",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace server",
    "dev:frontend": "npm run dev --workspace web",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "start": "npm run start --workspace server",
    "start:prod": "npm run db:deploy && npm run start",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace web",
    "lint": "npm run lint --workspace server && npm run lint --workspace web",
    "test": "npm run test --workspace server",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:seed": "prisma db seed --schema server/prisma/schema.prisma",
    "db:studio": "prisma studio --schema server/prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx server/prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
