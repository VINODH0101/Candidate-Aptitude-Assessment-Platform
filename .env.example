# ============================================================================
# Aptitude Assessment Platform — environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env` in the repository root, then edit the values:
#
#   copy .env.example .env        (Windows CMD)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# The `.env` file is git-ignored and never committed.
# ============================================================================

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# ---- Database (PostgreSQL) -------------------------------------------------
# Local development (see README for creating the database):
#   postgresql://<user>:<password>@localhost:5432/aptitude_assessment?schema=public
# Neon (production): DATABASE_URL = pooled connection string, DIRECT_URL = direct.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aptitude_assessment?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/aptitude_assessment?schema=public

# ---- Authentication --------------------------------------------------------
# JWT signing secret. REQUIRED, min 32 characters. Generate a unique value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-strong-random-32-plus-character-secret
ADMIN_SESSION_HOURS=8
CANDIDATE_SESSION_HOURS=12

# Password hashing cost (bcrypt). 12 recommended for production.
BCRYPT_ROUNDS=12

# ---- CORS / cookies ---------------------------------------------------------
# Comma-separated list of allowed browser origins.
# Local Vite dev server runs on 5173; production is same-origin.
CORS_ORIGIN=http://localhost:5173
# true = cookies only over HTTPS (required in production). Omit to auto-detect.
COOKIE_SECURE=false

# ---- Initial seed data (idempotent, used by `npm run db:seed`) -------------
# Seeded administrator account (created only if missing; never overwritten).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Platform Admin

# Optional demo candidate (created only if missing). Leave email blank to skip.
SEED_CANDIDATE_EMAIL=candidate@example.com
SEED_CANDIDATE_PASSWORD=Candidate123!
SEED_CANDIDATE_NAME=Demo Candidate

# Default application settings seeded into AppSetting (changeable at runtime).
ASSESSMENT_DURATION_MINUTES=15
PASS_PERCENTAGE=60

# ---- Frontend build-time ----------------------------------------------------
# API base for the SPA. Empty = same-origin (recommended for production).
VITE_API_BASE=

# ---- Tests (optional) -------------------------------------------------------
# Name of the throwaway database created/dropped by the Vitest suite.
TEST_DATABASE_NAME=aptitude_test
